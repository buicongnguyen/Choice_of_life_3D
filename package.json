{
  "name": "choice-of-life-3d",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "A warm 3D life adventure, built with Blender and Three.js.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/core.test.ts src/navigation.test.ts src/graphics.test.ts src/choice-copy.test.ts",
    "smoke": "node scripts/story-smoke.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/three": "0.185.3",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
